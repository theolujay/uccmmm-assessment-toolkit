+// @vitest-environment jsdom
+import { cleanup, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it } from 'vitest';
+import { assessmentTemplate, defaultMaturityBands, generateRecommendations, type DimensionScore } from '@assessment/contracts';
+import { RecommendationGroups } from './RecommendationGroups';
+
+afterEach(cleanup);
+
+function score(index: number, scorePercentage: number, maturityLevel: DimensionScore['maturityLevel']): DimensionScore {
+  const dimension = assessmentTemplate.dimensions[index];
+  return { dimensionId: dimension.id, dimensionName: dimension.name, scorePercentage, maturityLevel, itemCount: 5 };
+}
+
+describe('RecommendationGroups', () => {
+  it('groups actions by priority and shows what is needed to reach the next level', () => {
+    const recommendations = generateRecommendations([score(5, 20, 'Initial'), score(2, 56, 'Defined'), score(0, 72, 'Managed')], defaultMaturityBands);
+    render(<RecommendationGroups recommendations={recommendations} />);
+    expect(screen.getByRole('heading', { name: 'Act now' })).toBeTruthy();
+    expect(screen.getByRole('heading', { name: 'Plan next' })).toBeTruthy();
+    expect(screen.getByRole('heading', { name: 'Sustain and refine' })).toBeTruthy();
+    expect(screen.getByText(/Score more than 60% in this dimension \(currently 56%\)/)).toBeTruthy();
+  });
+
+  it('shows an empty state when nothing is recommended', () => {
+    render(<RecommendationGroups recommendations={[]} />);
+    expect(screen.getByText('No improvement actions needed')).toBeTruthy();
+  });
+});
diff --git a/apps/web/src/components/RecommendationGroups.tsx b/apps/web/src/components/RecommendationGroups.tsx
new file mode 100644
index 0000000..c9b68b9
--- /dev/null
+++ b/apps/web/src/components/RecommendationGroups.tsx
@@ -0,0 +1,34 @@
+import type { Recommendation, RecommendationPriority } from '@assessment/contracts';
+
+const groups: { priority: RecommendationPriority; title: string; description: string }[] = [
+  { priority: 'high', title: 'Act now', description: 'Dimensions at the Initial or Developing level.' },
+  { priority: 'medium', title: 'Plan next', description: 'Dimensions at the Defined level.' },
+  { priority: 'low', title: 'Sustain and refine', description: 'Dimensions at the Managed level.' },
+];
+
+export function RecommendationGroups({ recommendations }: { recommendations: readonly Recommendation[] }) {
+  if (recommendations.length === 0) {
+    return <article className="panel empty-state"><h2>No improvement actions needed</h2><p>Every dimension scored above the range where recommendations apply.</p></article>;
+  }
+  return <div className="roadmap">
+    {groups.map((group) => {
+      const items = recommendations.filter((item) => item.priority === group.priority);
+      if (items.length === 0) return null;
+      return <section className="roadmap-group" key={group.priority} aria-labelledby={`roadmap-${group.priority}`}>
+        <h2 id={`roadmap-${group.priority}`}>{group.title}</h2>
+        <p className="roadmap-description">{group.description}</p>
+        <div className="recommendation-list">
+          {items.map((item) => <article className="panel recommendation-card" key={item.id}>
+            <p className="recommendation-meta"><span className={`priority-tag ${item.priority}`}>{group.title}</span> {item.dimensionName} · {Math.round(item.scorePercentage)}% · {item.maturityLevel}</p>
+            <h3>{item.action}</h3>
+            <dl>
+              <div><dt>Weakness</dt><dd>{item.weakness}</dd></div>
+              <div><dt>Expected benefit</dt><dd>{item.benefit}</dd></div>
+              <div><dt>To reach {item.nextLevel}</dt><dd>Score more than {Math.round(item.scorePercentage + item.pointsToNextLevel)}% in this dimension (currently {Math.round(item.scorePercentage)}%).</dd></div>
+            </dl>
+          </article>)}
+        </div>
+      </section>;
+    })}
+  </div>;
+}
