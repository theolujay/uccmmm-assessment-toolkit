+/** Dimensions in this score range receive recommendations (README: 10% to 80%). */
+export const defaultRecommendationRange = { minScore: 10, maxScore: 80 } as const;
+
+function priorityFor(level: MaturityLevel): RecommendationPriority {
+  const index = levelIndex(level);
+  if (index <= 1) return 'high';
+  return index === 2 ? 'medium' : 'low';
+}
+
+/** Picks the single tier whose maxLevel is the lowest one that still covers the dimension's level. */
+function selectTier(entries: readonly RecommendationContent[], level: MaturityLevel): RecommendationContent[] {
+  const covering = entries.filter((entry) => levelIndex(entry.maxLevel) >= levelIndex(level));
+  if (covering.length === 0) return [];
+  const lowest = Math.min(...covering.map((entry) => levelIndex(entry.maxLevel)));
+  return covering.filter((entry) => levelIndex(entry.maxLevel) === lowest);
+}
+
+const priorityRank: Record<RecommendationPriority, number> = { high: 0, medium: 1, low: 2 };
+
+export function generateRecommendations(
+  dimensionScores: readonly DimensionScore[],
+  bands: readonly MaturityBand[],
+  options: { minScore?: number; maxScore?: number; library?: readonly RecommendationContent[] } = {},
+): Recommendation[] {
+  const { minScore, maxScore } = { ...defaultRecommendationRange, ...options };
+  const library = options.library ?? recommendationLibrary;
+  const keyed: { recommendation: Recommendation; order: number }[] = [];
+
+  dimensionScores.forEach((dimension, order) => {
+    const { scorePercentage, maturityLevel } = dimension;
+    if (scorePercentage < minScore || scorePercentage > maxScore) return;
+    const nextLevel = levelOrder[levelIndex(maturityLevel) + 1];
+    if (!nextLevel) return;
+    const currentBand = bands.find((band) => band.level === maturityLevel);
+    const pointsToNextLevel = currentBand ? Math.max(0, currentBand.upperBound - scorePercentage) : 0;
+    const matches = selectTier(library.filter((entry) => entry.dimensionId === dimension.dimensionId), maturityLevel);
+    matches.forEach((entry) => keyed.push({
+      order,
+      recommendation: {
+        ...entry,
+        dimensionName: dimension.dimensionName,
+        scorePercentage,
+        maturityLevel,
+        priority: priorityFor(maturityLevel),
+        nextLevel,
+        pointsToNextLevel,
+      },
+    }));
+  });
+
+  return keyed
+    .sort((first, second) => priorityRank[first.recommendation.priority] - priorityRank[second.recommendation.priority]
+      || first.recommendation.scorePercentage - second.recommendation.scorePercentage || first.order - second.order)
+    .map(({ recommendation }) => recommendation);
+}
+
+/** Dimensions from lowest score to highest; equal scores keep their original order (Report TC-R1). */
+export function rankDimensions<T extends Pick<DimensionScore, 'scorePercentage'>>(scores: readonly T[]): T[] {
+  return scores.map((score, order) => ({ score, order }))
+    .sort((first, second) => first.score.scorePercentage - second.score.scorePercentage || first.order - second.order)
+    .map(({ score }) => score);
+}
+
+export type QualificationSeverity = 'none' | 'weak' | 'critical';
+
+export interface OverallQualification {
+  severity: QualificationSeverity;
+  weakestDimension: DimensionScore;
+  strongestDimension: DimensionScore;
+  label: string;
+}
+
+/**
+ * Report 3.5.5: a strong overall score can hide a serious weakness, so the overall level is
+ * never reported in isolation. A dimension two or more levels below the overall level is a
+ * critical gap; one level below is a weak dimension. (Rule-based, needs no user-set target.)
+ */
+export function qualifyOverallResult(
+  summary: Pick<AssessmentScoreSummary, 'dimensionScores' | 'overallMaturityLevel'>,
+): OverallQualification {
+  if (summary.dimensionScores.length === 0) throw new Error('At least one dimension score is required.');
+  const ranked = rankDimensions(summary.dimensionScores);
+  const weakestDimension = ranked[0];
+  const strongestDimension = ranked[ranked.length - 1];
+  const levelsBelow = levelIndex(summary.overallMaturityLevel) - levelIndex(weakestDimension.maturityLevel);
+  if (levelsBelow >= 2) {
+    return { severity: 'critical', weakestDimension, strongestDimension, label: `${summary.overallMaturityLevel} with a critical gap in ${weakestDimension.dimensionName}` };
+  }
+  if (levelsBelow === 1) {
+    return { severity: 'weak', weakestDimension, strongestDimension, label: `${summary.overallMaturityLevel} overall, weakest in ${weakestDimension.dimensionName}` };
+  }
+  return { severity: 'none', weakestDimension, strongestDimension, label: summary.overallMaturityLevel };
+}
