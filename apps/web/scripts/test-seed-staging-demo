import assert from 'node:assert/strict';
import { Buffer } from 'node:buffer';

import { test } from 'node:test';
import { orgName, runDemo } from './seed-staging-demo';

const { Headers, Response, URL } = globalThis;

const url = 'https://abcdefghijklmnopqrst.supabase.co';
const orgId = '11111111-1111-4111-8111-111111111111';
const userId = '22222222-2222-4222-8222-222222222222';
const env = {
  UCCMMM_DEMO_URL: url,
  UCCMMM_DEMO_PUBLIC_KEY: 'sb_publishable_fake_for_mock_transport',
  UCCMMM_DEMO_EMAIL: 'admin@example.invalid',
  UCCMMM_DEMO_PASSWORD: 'test-placeholder',
};

function fakeJwt(role) {
  const payload = Buffer.from(JSON.stringify({ sub: userId, role, exp: 4_102_444_800 })).toString('base64url');
  return `eyJhbGciOiJIUzI1NiJ9.${payload}.fake-signature`;
}

// In-memory transport using the actual Supabase client. Nothing can reach the network.
function staging() {
  const token = fakeJwt('authenticated');
  const state = { name: orgName, role: 'admin', targets: { leadership: 75 }, records: new Map(), draft: null, writes: [], log: [] };
  const fetchImpl = async (input, init) => {
    const request = new URL(input);
    assert.equal(request.origin, url);
    assert.equal(init.redirect, 'error');
    const params = request.searchParams;
    const method = init.method ?? 'GET';
    const headers = new Headers(init.headers);
    const body = init.body ? JSON.parse(init.body) : undefined;
    const json = (data, status = 200) => Response.json(data, { status });
    const read = (data) => json(params.get('select') === 'id' && data ? [{ id: data.id }] : data ? [data] : []);
    if (request.pathname === '/auth/v1/token') {
      assert.equal(params.get('grant_type'), 'password');
      assert.equal(headers.get('apikey'), env.UCCMMM_DEMO_PUBLIC_KEY);
      assert.equal(body.email, env.UCCMMM_DEMO_EMAIL);
      assert.equal(body.password, env.UCCMMM_DEMO_PASSWORD);
      return json({ access_token: token, refresh_token: 'unused', token_type: 'bearer', expires_in: 3600, user: { id: userId } });
    }
    assert.equal(headers.get('authorization'), `Bearer ${token}`);
    if (method !== 'GET') state.writes.push([method, request.pathname]);
    switch (request.pathname) {
      case '/rest/v1/organization_members':
        assert.equal(params.get('user_id'), `eq.${userId}`);
        return read({ organization_id: orgId, role: state.role });
      case '/rest/v1/organizations': {
        assert.equal(params.get('id'), `eq.${orgId}`);
        if (method === 'GET') return read({ name: state.name, maturity_targets: state.targets });
        assert.equal(method, 'PATCH');
        assert.equal(params.get('name'), `eq.${orgName}`);
        if (state.changeDuringUpdate) state.targets = { leadership: 90 };
        if (params.get('maturity_targets') !== `eq.${JSON.stringify(state.targets)}`) return read(null);
        state.targets = body.maturity_targets;
        return read({ id: orgId });
      }
      case '/rest/v1/assessment_records':
        assert.equal(method, 'GET');
        return read(state.records.get(params.get('id').slice(3)));
      case '/rest/v1/rpc/submit_assessment_record': {
        assert.equal(method, 'POST');
        const { p_assessment_id: id, p_organization_id, p_respondent_type, p_assessment_version, p_responses, p_template_snapshot, p_evidence } = body;
        assert.equal(p_organization_id, orgId);
        assert.equal(p_respondent_type, 'admin');
        assert.equal(p_assessment_version, 'uccmm-v1');
        assert.equal(state.draft, null, 'existing draft would be deleted by the respondent trigger');
        assert.equal(state.records.has(id), false);
        const dimensionScores = [76, 64, 60, 52, 68, 48];
        const dimensionLevels = ['Managed', 'Managed', 'Defined', 'Defined', 'Managed', 'Defined'];
        const record = {
          id, organization_id: orgId, respondent_type: 'admin', assessment_version: 'uccmm-v1',
          responses: p_responses, evidence: p_evidence, template_snapshot: p_template_snapshot,
          target_snapshot: { ...state.targets }, overall_score: '61.33333', overall_maturity_level: 'Managed',
          dimension_scores: p_template_snapshot.dimensions.map((dimension, index) => ({
            dimensionId: dimension.id, dimensionName: dimension.name, itemCount: 5,
            scorePercentage: dimensionScores[index], maturityLevel: dimensionLevels[index],
          })),
        };
        state.records.set(id, record);
        // Simulate an unconfirmed result after the database already committed the RPC.
        return state.loseSubmissionResponse ? json({ message: 'mock failure' }, 400) : json(record);
      }
      case '/rest/v1/assessment_drafts':
        if (method === 'GET') {
          assert.equal(params.get('user_id'), `eq.${userId}`);
          assert.equal(params.get('assessment_version'), 'eq.uccmm-v1');
          return read(state.draft);
        }
        assert.equal(method, 'POST');
        assert.equal(params.get('on_conflict'), null);
        assert.doesNotMatch(headers.get('prefer') ?? '', /resolution=merge-duplicates/);
        if (state.draftAtInsert) state.draft = state.draftAtInsert;
        if (state.draft) return json({ code: '23505', message: 'draft slot occupied' }, 409);
        state.draft = body;
        return json({ id: body.id }, 201);
      default:
        assert.fail(`Unexpected request path: ${request.pathname}`);
    }
  };
  state.run = () => runDemo(['--write', url], env, { fetchImpl, log: (line) => state.log.push(line) });
  return state;
}

const noFetch = () => assert.fail('Unexpected network request');

test('default dry-run calculates the example offline, even with write credentials present', async () => {
  const log = [];
  await runDemo([], env, { fetchImpl: noFetch, log: (line) => log.push(line) });
  assert.match(log[0], /61\.33% Managed; resilience 48% vs 80% \(32-point gap\)/);
  assert.match(log[1], /6\/30 answered.*communication-2/);
});

test('rejects missing or mismatched project confirmation and privileged keys before authentication', async () => {
  const options = { fetchImpl: noFetch };
  await assert.rejects(runDemo(['--write'], env, options), /Expected no arguments/);
  await assert.rejects(runDemo(['--write', 'https://zyxwvutsrqponmlkjihg.supabase.co'], env, options), /exact hosted staging URL/);
  for (const key of [fakeJwt('service_role'), 'sb_secret_fake']) {
    await assert.rejects(runDemo(['--write', url], { ...env, UCCMMM_DEMO_PUBLIC_KEY: key }, options), /never a secret or service-role key/);
  }
});

test('requires the exact fictional organisation and Admin membership', async () => {
  const state = staging();
  state.name = orgName.toLowerCase();
  await assert.rejects(state.run(), /name must be exactly/);
  state.name = orgName;
  state.role = 'stakeholder';
  await assert.rejects(state.run(), /not an organisation Admin/);
  assert.deepEqual(state.writes, []);
});

test('conflicting resilience target or a pre-existing draft blocks all writes', async () => {
  const state = staging();
  state.targets.resilience = 70;
  await assert.rejects(state.run(), /other than 80%/);
  delete state.targets.resilience;
  state.draft = { id: 'user-draft', organization_id: orgId, respondent_type: 'admin' };
  await assert.rejects(state.run(), /would delete the draft/);
  assert.deepEqual(state.targets, { leadership: 75 });
  assert.deepEqual(state.writes, []);
});

test('target compare-and-set does not overwrite intervening edits or submit a baseline', async () => {
  const state = staging();
  state.changeDuringUpdate = true;
  await assert.rejects(state.run(), /nothing was overwritten/);
  assert.deepEqual(state.targets, { leadership: 90 });
  assert.deepEqual(state.writes, [['PATCH', '/rest/v1/organizations']]);
});

test('uses the app RPC with the exact fixture, then inserts a distinct partial draft', async () => {
  const state = staging();
  await state.run();
  assert.deepEqual(state.writes, [
    ['PATCH', '/rest/v1/organizations'], ['POST', '/rest/v1/rpc/submit_assessment_record'], ['POST', '/rest/v1/assessment_drafts'],
  ]);
  assert.equal(state.records.size, 1);
  const [baseline] = state.records.values();
  assert.deepEqual(Object.values(baseline.responses), [4, 4, 4, 4, 3, 3, 3, 3, 3, 4, 3, 3, 3, 3, 3, 3, 3, 3, 2, 2, 4, 3, 4, 3, 3, 3, 3, 2, 2, 2]);
  assert.deepEqual(state.targets, { leadership: 75, resilience: 80 });
  assert.deepEqual(baseline.target_snapshot, state.targets);
  assert.notEqual(baseline.id, state.draft.id);
  assert.equal(state.draft.user_id, userId);
  assert.equal(state.draft.status, 'in_progress');
  assert.equal(state.draft.active_question_id, 'communication-2');
  assert.deepEqual(state.draft.responses, { 'leadership-1': 4, 'leadership-2': 4, 'leadership-3': 4, 'leadership-4': 4, 'leadership-5': 3, 'communication-1': 3 });
});

test('retry after a committed submission reuses the baseline, then preserves changed draft and targets', async () => {
  const state = staging();
  state.targets.resilience = 80;
  state.loseSubmissionResponse = true;
  await assert.rejects(state.run(), /Submit baseline failed/);
  assert.deepEqual(state.writes, [['POST', '/rest/v1/rpc/submit_assessment_record']]);
  state.loseSubmissionResponse = false;
  state.writes.length = 0;
  await state.run();
  assert.deepEqual(state.writes, [['POST', '/rest/v1/assessment_drafts']]);
  assert.equal(state.records.size, 1);
  state.draft.responses['leadership-1'] = 2;
  state.targets = { leadership: 95 };
  state.writes.length = 0;
  await state.run();
  assert.deepEqual(state.writes, []);
  assert.deepEqual(state.targets, { leadership: 95 });
  assert.equal(state.draft.responses['leadership-1'], 2);

  // Once submitted, that draft ID must never be reused for a live draft.
  state.records.set(state.draft.id, { id: state.draft.id });
  state.draft = null;
  await state.run();
  assert.deepEqual(state.writes, []);
  assert.match(state.log.join('\n'), /already submitted; no replacement draft/);
});

test('a draft that occupies the slot just before insert is never overwritten', async () => {
  const state = staging();
  state.draftAtInsert = { id: 'late-draft', organization_id: orgId, respondent_type: 'admin', responses: { 'leadership-1': 1 } };
  await assert.rejects(state.run(), /Insert partial draft.*failed/);
  assert.deepEqual(state.draft, state.draftAtInsert);
  state.writes.length = 0;
  await state.run();
  assert.deepEqual(state.writes, []);
  assert.deepEqual(state.draft, state.draftAtInsert);
});

test('an unexpected record at the baseline ID is not treated as the demo', async () => {
  const state = staging();
  await state.run();
  state.writes.length = 0;
  state.draft = null;
  const [baseline] = state.records.values();
  baseline.target_snapshot.resilience = 75;
  await assert.rejects(state.run(), /does not match the worked example/);
  assert.deepEqual(state.writes, []);
});
